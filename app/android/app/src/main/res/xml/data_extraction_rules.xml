<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 31 이상 기기에서 앱 데이터가 클라우드 백업과 기기 간 이전으로 나가지 않게 모든 도메인을 뺀다.
     로그인 세션은 Keystore로 암호화한 파일에 있어 복원해도 읽히지 않지만, 토큰이 사본에 남을 이유가 없다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
