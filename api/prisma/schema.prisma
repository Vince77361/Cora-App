generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL은 Supavisor 풀링 연결(런타임), DIRECT_URL은 마이그레이션처럼 풀러를 거치면 안 되는 작업용이다.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STORE
  BRAND
  CREATOR

  @@map("user_role")
}

model User {
  // Supabase Auth 사용자 ID와 같은 값을 쓰므로 기본값을 만들지 않는다.
  id        String    @id @db.Uuid
  role      UserRole?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  store          Store?
  creatorProfile CreatorProfile?
  applications   Application[]
  offers         Offer[]
  creatorSeries  CreatorSeries[]

  commissionedCollaborations Collaboration[]      @relation("CollaborationCommissioner")
  creatorCollaborations      Collaboration[]      @relation("CollaborationCreator")
  payoutAccount              PayoutAccount?
  instagramConnection        InstagramConnection?
  cancelRequests             CancelRequest[]
  notifications              Notification[]
  notificationSetting        NotificationSetting?

  @@map("users")
}

enum StoreStatus {
  DRAFT
  PUBLISHED

  @@map("store_status")
}

enum StoreOnboardingStep {
  PAGE
  DRAFTS
  TERMS
  DONE

  @@map("store_onboarding_step")
}

enum SourceLinkKind {
  NAVER_MAP
  CATCHTABLE
  INSTAGRAM
  // 체험단 후기 글(네이버 블로그, 티스토리). 글을 인스타 게시물 초안으로 바꾸는 것은 AI 제작 계획의 몫이다.
  REVIEW_POST

  @@map("source_link_kind")
}

enum ContentDraftKind {
  CARD_NEWS
  REELS_SCRIPT
  BLOG

  @@map("content_draft_kind")
}

enum ContentFormat {
  SHORTS
  REELS
  CARD_NEWS
  BLOG

  @@map("content_format")
}

// 보상의 세 요소(식사권, 고정 현금, 조회수 수당)는 열의 값으로 말한다. 사용권은 오퍼마다 정한다.
enum UsageRights {
  STORE_REPOST_3M
  STORE_REPOST_6M
  NONE

  @@map("usage_rights")
}

enum ApplicationStatus {
  APPLIED
  CANCELLED
  OFFERED
  CLOSED

  @@map("application_status")
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED

  @@map("offer_status")
}

// 공통 모델 3장의 업종 분류. 앞 9개는 일반, 뒤 4개(ALCOHOL~DIET_SUPPLEMENT)는 크리에이터가 피할 수 있는 민감 업종이다.
enum IndustryCategory {
  FOOD_CAFE
  BEAUTY
  FASHION
  ACCESSORY
  LIVING
  GROCERY
  DIGITAL
  HEALTH
  OTHER
  ALCOHOL
  GAMBLING
  LOAN
  DIET_SUPPLEMENT

  @@map("industry_category")
}

model Store {
  id                         String              @id @default(uuid()) @db.Uuid
  // 한 계정에 가게는 하나다.
  ownerId                    String              @unique @map("owner_id") @db.Uuid
  status                     StoreStatus         @default(DRAFT)
  onboardingStep             StoreOnboardingStep @default(PAGE) @map("onboarding_step")
  name                       String?
  // 표시용 자유 입력 업종(예: 라멘집). 분류는 industry다.
  category                   String?
  industry                   IndustryCategory    @default(FOOD_CAFE)
  // 표시용 동네. 지역 정렬에는 regionSido, regionSigungu를 쓴다.
  neighborhood               String?
  regionSido                 String?             @map("region_sido")
  regionSigungu              String?             @map("region_sigungu")
  coverPhotoPath             String?             @map("cover_photo_path")
  signatureMenu              String?             @map("signature_menu")
  hours                      String?
  seats                      String?
  bestShootingTime           String?             @map("best_shooting_time")
  intro                      String?
  // 공개 주소 이름(cora.page/l/{slug}). 이름이 처음 생길 때 만들고 이름을 고쳐도 바꾸지 않는다.
  slug                       String?             @unique
  // 꼬리표(# 없이), 손님들이 자주 한 말. 링크 분석이 채우고 사장님이 고친다.
  tags                       String[]            @default([])
  customerPhrases            String[]            @default([]) @map("customer_phrases")
  // 크리에이터에게 보이는 모집 한 줄.
  recruitLine                String?             @map("recruit_line")
  defaultFormat              ContentFormat?      @map("default_format")
  defaultVoucherName         String?             @map("default_voucher_name")
  defaultVoucherValue        Int?                @map("default_voucher_value")
  defaultVoucherPeople       Int?                @map("default_voucher_people")
  defaultFixedCash           Int                 @default(0) @map("default_fixed_cash")
  // 단가는 "1,000회당 원"이다. 조회수 수당이 없으면 단가와 상한이 모두 null이다.
  defaultViewRatePerThousand Int?                @map("default_view_rate_per_thousand")
  defaultPerViewCap          Int?                @map("default_per_view_cap")
  defaultUsageRights         UsageRights         @default(STORE_REPOST_3M) @map("default_usage_rights")
  // 공개한 시각. 공개 목록의 "최근 공개 순"에 쓴다.
  publishedAt                DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?           @map("deleted_at") @db.Timestamptz(3)

  owner          User                @relation(fields: [ownerId], references: [id])
  sourceLinks    StoreSourceLink[]
  drafts         StoreContentDraft[]
  applications   Application[]
  offers         Offer[]
  collaborations Collaboration[]

  @@map("stores")
}

model StoreSourceLink {
  id        String         @id @default(uuid()) @db.Uuid
  storeId   String         @map("store_id") @db.Uuid
  kind      SourceLinkKind
  url       String
  summary   String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("store_source_links")
}

model StoreContentDraft {
  id                 String           @id @default(uuid()) @db.Uuid
  storeId            String           @map("store_id") @db.Uuid
  kind               ContentDraftKind
  bodyLabel          String           @map("body_label")
  body               String
  scenes             Json
  // 다시 만들기마다 올라가는 번호. 가짜 구현이 견본 두 벌을 번갈아 주는 데 쓴다.
  version            Int              @default(1)
  // 하루 다시 만들기 횟수를 세려고 마지막으로 다시 만든 날(한국 날짜)과 그날의 횟수를 함께 둔다.
  regeneratedOn      DateTime?        @map("regenerated_on") @db.Date
  regenerationsOnDay Int              @default(0) @map("regenerations_on_day")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, kind])
  @@map("store_content_drafts")
}

model CreatorProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  displayName     String    @map("display_name")
  contentFocus    String?   @map("content_focus")
  instagramHandle String?   @map("instagram_handle")
  photoPath       String?   @map("photo_path")
  regionSido      String    @map("region_sido")
  regionSigungu   String?   @map("region_sigungu")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("creator_profiles")
}

// 같은 가게·크리에이터의 살아 있는 지원(APPLIED, OFFERED)은 하나뿐이다.
// 이 제약은 부분 유니크 인덱스라 Prisma 스키마로 적을 수 없어 마이그레이션의 직접 SQL에 있다.
model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  storeId            String            @map("store_id") @db.Uuid
  creatorId          String            @map("creator_id") @db.Uuid
  status             ApplicationStatus
  // 지원에 붙인 한 줄(100자까지). 없으면 null.
  pitch              String?
  // 사장님이 추천에서 건너뛴 시각(Task 16이 쓴다).
  skippedFromPicksAt DateTime?         @map("skipped_from_picks_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(3)

  store   Store   @relation(fields: [storeId], references: [id])
  creator User    @relation(fields: [creatorId], references: [id])
  offers  Offer[]

  @@index([storeId, status])
  @@index([creatorId])
  @@map("applications")
}

// 크리에이터가 만들어 두는 연재(시리즈). 제안을 낼 때 이름·형식·설명을 판본에 사본으로 넣는다. 한 크리에이터에 5개까지.
model CreatorSeries {
  id        String        @id @default(uuid()) @db.Uuid
  creatorId String        @map("creator_id") @db.Uuid
  name      String
  format    ContentFormat
  note      String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(3)

  creator User @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@map("creator_series")
}

enum OfferParty {
  STORE
  CREATOR

  @@map("offer_party")
}

// 오퍼가 끝난 까닭. 응답하지 않은 쪽이 아니라 끝낸 쪽이 고른다(Task 6).
enum OfferEndReason {
  SCHEDULE
  TERMS
  OTHER_PARTNER
  NO_REASON

  @@map("offer_end_reason")
}

// 같은 가게·크리에이터의 열린 오퍼(SENT, 또는 협업이 끝나지 않은 ACCEPTED)는 하나뿐이다. 부분 유니크 인덱스는 마이그레이션의 직접 SQL에 있다.
// 조건(형식, 보상, 사용권, 아이디어)은 오퍼가 아니라 판본(offer_versions)에 있다. 오퍼는 흐름만 가진다.
model Offer {
  id            String          @id @default(uuid()) @db.Uuid
  storeId       String          @map("store_id") @db.Uuid
  creatorId     String          @map("creator_id") @db.Uuid
  applicationId String?         @map("application_id") @db.Uuid
  status        OfferStatus
  // 가장 새 판본의 번호. 판본을 만드는 트랜잭션이 함께 올리고, 수락은 이 번호를 조건부 갱신에 건다.
  latestVersion Int             @default(1) @map("latest_version")
  // 지금 응답할 차례. 최신 판본을 쓰지 않은 쪽이다.
  turn          OfferParty
  initiatedBy   OfferParty      @map("initiated_by")
  endReason     OfferEndReason? @map("end_reason")
  endedBy       OfferParty?     @map("ended_by")
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  acceptedAt    DateTime?       @map("accepted_at") @db.Timestamptz(3)
  paymentDueAt  DateTime?       @map("payment_due_at") @db.Timestamptz(3)
  declinedAt    DateTime?       @map("declined_at") @db.Timestamptz(3)
  respondedAt   DateTime?       @map("responded_at") @db.Timestamptz(3)
  // 연결된 협업이 끝난(SETTLED, REFUNDED, CANCELLED) 시각. 차면 ACCEPTED여도 열린 오퍼로 세지 않아 같은 가게가 다시 오퍼할 수 있다.
  closedAt      DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)

  store         Store          @relation(fields: [storeId], references: [id])
  creator       User           @relation(fields: [creatorId], references: [id])
  application   Application?   @relation(fields: [applicationId], references: [id])
  collaboration Collaboration?
  versions      OfferVersion[]

  @@index([storeId, status])
  @@index([creatorId, status])
  @@index([expiresAt])
  @@map("offers")
}

// 오퍼 조건의 한 판본. 만들기만 하고 고치거나 지우지 않는다(열은 공통 규칙대로 둔다).
// 단가는 "1,000회당 원"이다. 조회수 수당이 없으면 단가와 상한이 모두 null이다.
model OfferVersion {
  id                  String         @id @default(uuid()) @db.Uuid
  offerId             String         @map("offer_id") @db.Uuid
  number              Int
  authorParty         OfferParty     @map("author_party")
  format              ContentFormat
  pieces              Int            @default(1)
  voucherName         String?        @map("voucher_name")
  voucherValue        Int?           @map("voucher_value")
  voucherPeople       Int?           @map("voucher_people")
  fixedCash           Int            @map("fixed_cash")
  viewRatePerThousand Int?           @map("view_rate_per_thousand")
  perViewCap          Int?           @map("per_view_cap")
  usageRights         UsageRights    @map("usage_rights")
  idea                String?
  principles          String[]
  seriesName          String?        @map("series_name")
  seriesFormat        ContentFormat? @map("series_format")
  seriesNote          String?        @map("series_note")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(3)

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, number])
  @@index([offerId])
  @@map("offer_versions")
}

// ---- 협업·결제·장부 (3번 계획) ----
// 모든 금액은 원 단위 정수다. 장부·스냅샷·감사 기록은 만들기만 하고 고치거나 지우지 않는다(열은 공통 규칙대로 둔다).

enum CollaborationKind {
  STORE_OFFER
  BRAND_CONTRACT

  @@map("collaboration_kind")
}

// 단계 규칙(허용 전이)은 src/collaborations/collaboration-stage.ts의 canTransition이 정한다.
enum CollaborationStage {
  AWAITING_PAYMENT
  FUNDED
  COUNTING
  SETTLED
  REFUNDED
  CANCELLED
  INQUIRY
  MATCHED
  NEGOTIATING
  AGREED
  CONTRACTED
  GUIDED
  REVIEWING
  APPROVED
  PUBLISHED
  DROPPED
  HALTED

  @@map("collaboration_stage")
}

// NONE은 식사권만 있는 오퍼로, 낼 돈과 줄 돈이 없다.
enum SettlementMethod {
  PER_VIEW
  FIXED
  NONE
  FIXED_AND_PER_VIEW

  @@map("settlement_method")
}

enum LedgerAccount {
  PG_IN
  ESCROW
  CREATOR_PAYABLE
  STORE_REFUND
  FEE_REVENUE

  @@map("ledger_account")
}

enum PaymentMethod {
  CARD
  TRANSFER
  EASY_PAY

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  CANCELLED

  @@map("payment_status")
}

// 지급(payouts)과 환급(refunds)이 같이 쓴다.
enum TransferStatus {
  PENDING
  DONE
  FAILED

  @@map("transfer_status")
}

enum CancelRequestStatus {
  PENDING
  ACCEPTED
  EXPIRED

  @@map("cancel_request_status")
}

// 협업 한 건. "이 협업이 지금 어디인가"는 stage 하나로 답한다.
// commissionerId는 맡기는 쪽(가게 사장님 또는 브랜드) 사용자다.
model Collaboration {
  id               String              @id @default(uuid()) @db.Uuid
  kind             CollaborationKind
  stage            CollaborationStage
  commissionerId   String              @map("commissioner_id") @db.Uuid
  creatorId        String              @map("creator_id") @db.Uuid
  // 오퍼 하나에 협업 하나. null은 브랜드 계약처럼 오퍼 없이 생기는 협업이다.
  offerId          String?             @unique @map("offer_id") @db.Uuid
  storeId          String?             @map("store_id") @db.Uuid
  // 수락할 때의 조건(OfferTermsModel) 사본. 이후 가게 기본 조건이 바뀌어도 이 협업은 그대로다.
  terms            Json
  settlementMethod SettlementMethod    @map("settlement_method")
  fundedAt         DateTime?           @map("funded_at") @db.Timestamptz(3)
  submitDueAt      DateTime?           @map("submit_due_at") @db.Timestamptz(3)
  submittedUrl     String?             @map("submitted_url")
  submittedAt      DateTime?           @map("submitted_at") @db.Timestamptz(3)
  countingEndsAt   DateTime?           @map("counting_ends_at") @db.Timestamptz(3)
  haltedReason     String?             @map("halted_reason")
  stageBeforeHalt  CollaborationStage? @map("stage_before_halt")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)

  commissioner User   @relation("CollaborationCommissioner", fields: [commissionerId], references: [id])
  creator      User   @relation("CollaborationCreator", fields: [creatorId], references: [id])
  offer        Offer? @relation(fields: [offerId], references: [id])
  store        Store? @relation(fields: [storeId], references: [id])

  payments       Payment[]
  ledgerEntries  LedgerEntry[]
  viewSnapshots  ViewSnapshot[]
  settlement     Settlement?
  payouts        Payout[]
  refunds        Refund[]
  cancelRequests CancelRequest[]
  opsAuditLogs   OpsAuditLog[]

  @@index([storeId, stage])
  @@index([creatorId, stage])
  @@index([commissionerId, stage])
  @@index([stage, countingEndsAt])
  @@map("collaborations")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  collaborationId String        @map("collaboration_id") @db.Uuid
  amountEscrow    Int           @map("amount_escrow")
  amountFee       Int           @map("amount_fee")
  // 결제할 때의 수수료율(%) 사본. 설정이 바뀌어도 이 결제의 수수료는 그대로다.
  feeRate         Int           @map("fee_rate")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  pgTransactionId String?       @unique @map("pg_transaction_id")
  requestedAt     DateTime      @map("requested_at") @db.Timestamptz(3)
  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])

  @@index([collaborationId, status])
  @@map("payments")
}

// 복식 장부 한 줄. 만들기만 하고 고치거나 지우지 않는다. 정정은 반대 줄을 더한다.
// 같은 동작이 두 번 실행돼도 (idempotencyKey, debitAccount, creditAccount) 유일 제약이 두 번째를 막는다.
model LedgerEntry {
  id              String        @id @default(uuid()) @db.Uuid
  collaborationId String        @map("collaboration_id") @db.Uuid
  // 한 동작이 만든 줄들을 묶는 값.
  batchId         String        @map("batch_id") @db.Uuid
  debitAccount    LedgerAccount @map("debit_account")
  creditAccount   LedgerAccount @map("credit_account")
  amount          Int
  reason          String
  idempotencyKey  String        @map("idempotency_key")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])

  @@unique([idempotencyKey, debitAccount, creditAccount])
  @@index([collaborationId])
  @@index([batchId])
  @@map("ledger_entries")
}

// 조회수 스냅샷. views가 null이면 그날 읽지 못한 것이다(0이 아니다).
// dayIndex 0~7의 범위는 마이그레이션의 CHECK 제약이 지킨다.
model ViewSnapshot {
  id              String    @id @default(uuid()) @db.Uuid
  collaborationId String    @map("collaboration_id") @db.Uuid
  takenAt         DateTime  @map("taken_at") @db.Timestamptz(3)
  views           Int?
  dayIndex        Int       @map("day_index")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])

  @@unique([collaborationId, dayIndex])
  @@map("view_snapshots")
}

model Settlement {
  id              String    @id @default(uuid()) @db.Uuid
  collaborationId String    @unique @map("collaboration_id") @db.Uuid
  finalViews      Int?      @map("final_views")
  payoutAmount    Int       @map("payout_amount")
  refundAmount    Int       @map("refund_amount")
  settledAt       DateTime  @map("settled_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])

  @@map("settlements")
}

model Payout {
  id              String         @id @default(uuid()) @db.Uuid
  collaborationId String         @map("collaboration_id") @db.Uuid
  amount          Int
  status          TransferStatus @default(PENDING)
  externalId      String?        @map("external_id")
  idempotencyKey  String         @unique @map("idempotency_key")
  // 송금할 수요일 10:00(한국 시간).
  scheduledFor    DateTime       @map("scheduled_for") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])

  @@index([status, scheduledFor])
  @@index([collaborationId])
  @@map("payouts")
}

model Refund {
  id              String         @id @default(uuid()) @db.Uuid
  collaborationId String         @map("collaboration_id") @db.Uuid
  amount          Int
  status          TransferStatus @default(PENDING)
  externalId      String?        @map("external_id")
  idempotencyKey  String         @unique @map("idempotency_key")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])

  @@index([collaborationId])
  @@map("refunds")
}

// 계좌번호는 AES-256-GCM으로 암호화해 저장한다. 응답과 로그에는 뒤 4자리만 낸다.
model PayoutAccount {
  id               String    @id @default(uuid()) @db.Uuid
  creatorId        String    @unique @map("creator_id") @db.Uuid
  bankCode         String    @map("bank_code")
  accountNumberEnc String    @map("account_number_enc")
  accountLast4     String    @map("account_last4")
  holderName       String    @map("holder_name")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  creator User @relation(fields: [creatorId], references: [id])

  @@map("payout_accounts")
}

model InstagramConnection {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @unique @map("creator_id") @db.Uuid
  handle      String    @unique
  followers   Int?
  tokenEnc    String?   @map("token_enc")
  refreshedAt DateTime  @map("refreshed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  creator User @relation(fields: [creatorId], references: [id])

  @@map("instagram_connections")
}

model CancelRequest {
  id              String              @id @default(uuid()) @db.Uuid
  collaborationId String              @map("collaboration_id") @db.Uuid
  requestedById   String              @map("requested_by_id") @db.Uuid
  status          CancelRequestStatus @default(PENDING)
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])
  requestedBy   User          @relation(fields: [requestedById], references: [id])

  @@index([collaborationId, status])
  @@map("cancel_requests")
}

// 운영 명령의 기록. 운영자는 DB를 직접 고치지 않고 이 계획의 운영 명령만 쓴다.
model OpsAuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  command         String
  collaborationId String?   @map("collaboration_id") @db.Uuid
  operator        String
  reason          String
  detail          Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  collaboration Collaboration? @relation(fields: [collaborationId], references: [id])

  @@index([collaborationId])
  @@map("ops_audit_logs")
}

// ---- 알림 (3번 계획 Task 3A) ----

enum NotificationTab {
  MATCHING
  COLLABORATION
  SETTLEMENT

  @@map("notification_tab")
}

// 설정 화면(E5)의 스위치. ESSENTIAL은 어느 스위치에도 걸리지 않는, 끌 수 없는 알림이다.
enum NotificationSwitch {
  MUTUAL_INTEREST
  OFFERS
  MESSAGES
  SETTLEMENT
  RECOMMENDATIONS
  ESSENTIAL

  @@map("notification_switch")
}

enum NotificationGlyph {
  WON
  PEN

  @@map("notification_glyph")
}

// 종류의 탭·스위치·그림·문구는 src/notifications/notification-catalog.ts가 정한다. 4~8번 계획이 자기 종류를 더한다.
enum NotificationKind {
  APPLICATION_RECEIVED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  PAYMENT_FUNDED
  CONTENT_SUBMITTED
  SUBMIT_REMINDER
  UNSUBMITTED_ENDED
  UNSUBMITTED_REFUNDED
  CREATOR_CANCELLED
  CANCEL_REQUESTED
  COLLABORATION_HALTED
  SETTLEMENT_CONFIRMED
  PAYOUT_DONE
  SETTLEMENT_REFUNDED
  OFFER_COUNTERED
  OFFER_REVISED
  OFFER_ACCEPTED_BY_STORE
  OFFER_ENDED

  @@map("notification_kind")
}

enum QuietHours {
  OFF
  NIGHT
  WEEKEND

  @@map("quiet_hours")
}

// 알림함 한 줄. 문구는 만들 때 저장하지 않고 종류·값·상대 사본으로 읽을 때 만든다.
// 상대의 이름과 사진 경로는 사본이라, 상대가 이름을 바꾸거나 탈퇴해도 이 줄은 그대로다(탈퇴 흐름이 따로 바꾼다).
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  // 받는 역할. 역할이 여럿인 계정에서 지금 역할의 알림만 보이게 한다.
  role           UserRole
  kind           NotificationKind
  // 알림함에 남기지 않는 종류는 줄을 만들지 않으므로 여기서는 항상 값이 있다.
  tab            NotificationTab?
  params         Json
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  actorName      String?          @map("actor_name")
  actorPhotoPath String?          @map("actor_photo_path")
  // 가는 곳의 종류는 4~8번 계획이 늘리므로 DB enum이 아닌 문자열로 두고 코드의 타입이 지킨다.
  targetKind     String           @map("target_kind")
  targetId       String?          @map("target_id")
  // 같은 키의 두 번째 알림은 줄도 푸시도 만들지 않는다. 키가 없으면(null) 제약에 걸리지 않는다.
  dedupeKey      String?          @map("dedupe_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, role, createdAt(sort: Desc)])
  @@map("notifications")
}

// 설정은 사람(계정) 하나에 하나다. 행이 없으면 기본값으로 본다.
model NotificationSetting {
  id                      String     @id @default(uuid()) @db.Uuid
  userId                  String     @unique @map("user_id") @db.Uuid
  mutualInterest          Boolean    @default(true) @map("mutual_interest")
  offers                  Boolean    @default(true)
  messages                Boolean    @default(true)
  settlement              Boolean    @default(true)
  recommendations         Boolean    @default(false)
  // 추천 소식을 켠 시각(광고성 수신 동의 기록).
  recommendationsAgreedAt DateTime?  @map("recommendations_agreed_at") @db.Timestamptz(3)
  quietHours              QuietHours @default(NIGHT) @map("quiet_hours")
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?  @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("notification_settings")
}
