# 이 파일을 api/.env로 복사해 값을 채운다. api/.env는 커밋하지 않는다.

NODE_ENV=development
PORT=3000

# 푸시 알림 어댑터. 개발에서는 가짜 구현을 쓴다.
PUSH_ADAPTER=fake

# Supabase 프로젝트 URL.
# 대시보드 Project Settings → Data API 의 "Project URL".
SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase service_role 키.
# 대시보드 Project Settings → API Keys 의 service_role (secret) 키.
# 모든 RLS를 우회하는 키이므로 서버에서만 쓴다. 앱, 로그, 커밋에 절대 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# 풀링 연결(Supavisor 트랜잭션 모드, 포트 6543). 서버가 런타임에 쓴다.
# 대시보드 상단 Connect → Connection String → Transaction pooler 에서 복사한다.
# Prisma 6은 트랜잭션 풀러에서 ?pgbouncer=true 가 필요하다.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 직접 연결(포트 5432). 마이그레이션처럼 풀러를 거치면 안 되는 작업에 쓴다.
# 대시보드 Connect → Connection String → Direct connection (또는 Session pooler) 에서 복사한다.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 자동 테스트용. 같은 DB의 cora_test 스키마에서 돈다.
# DATABASE_URL에 이미 쿼리 문자열이 있으므로 &schema=cora_test 를 붙인다.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=cora_test"

# DIRECT_URL 에 ?schema=cora_test 를 붙인다.
TEST_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=cora_test"

# (선택) Supabase JWT 시크릿. 이 프로젝트의 Supabase는 비대칭 키(ES256)로 토큰을 서명하고
# JWKS로 검증하므로 필요하지 않다. 레거시 HS256 프로젝트일 때만 채운다.
# SUPABASE_JWT_SECRET=
