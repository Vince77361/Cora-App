# 이 파일을 api/.env로 복사해 값을 채운다. api/.env는 커밋하지 않는다.

NODE_ENV=development
PORT=3000

# 푸시 알림 어댑터. 개발에서는 가짜 구현을 쓴다.
PUSH_ADAPTER=fake

# 가게 링크 분석, AI 초안 어댑터. 실제 구현은 9번 계획에서 만든다. 그 전까지는 fake만 쓴다.
STORE_LINK_ADAPTER=fake
CONTENT_DRAFT_ADAPTER=fake

# 결제·송금·조회수·인스타그램·운영자 알림 어댑터(fake | real). 개발에서는 비워도 fake다.
# 실제 구현은 "실제 연동 교체" 계획에서 만든다. 운영(NODE_ENV=production)에서는 반드시 직접 적어야 하고, fake면 서버가 시작을 거부한다.
PAYMENT_ADAPTER=fake
PAYOUT_ADAPTER=fake
VIEW_COUNT_ADAPTER=fake
INSTAGRAM_ADAPTER=fake
OPERATOR_ALERT_ADAPTER=fake

# 작업 큐(BullMQ)가 쓰는 Redis. 개발에서는 비워도 아래 로컬 주소를 쓴다(저장소 루트에서 docker compose up -d redis).
# 운영에서는 반드시 적어야 한다. 테스트(NODE_ENV=test)는 Redis에 연결하지 않는다.
REDIS_URL=redis://127.0.0.1:6379

# 이 프로세스에서 작업 큐의 작업자를 켤지(on, off). 비우면 on이다. 운영 명령(yarn ops)은 스스로 off로 맞추므로 적지 않는다.
# JOBS_WORKER=

# 운영자 알림(정산 멈춤 등)을 받을 이메일. 개발에서는 비워도 되고, 운영에서는 필수다.
# OPERATOR_EMAIL=

# 크리에이터 계좌번호를 암호화하는 AES-256-GCM 키(32바이트를 base64로). 만드는 법: openssl rand -base64 32
# 개발에서는 비워도 서버가 시작하지만, 계좌를 저장하려는 순간 오류가 난다. 운영에서는 필수이고 형식이 틀리면 시작을 거부한다.
# 잃어버리면 저장된 계좌번호를 풀 수 없으니 운영 키는 따로 안전하게 보관한다. 로그와 커밋에 절대 넣지 않는다.
# PAYOUT_ACCOUNT_KEY=

# 결제 통지(웹훅) 서명 비밀값. 만드는 법: openssl rand -base64 32 (32자 이상)
# 개발에서는 비워도 서버가 시작하지만, 결제 통지를 만들거나 확인하려는 순간 오류가 난다. 운영에서는 필수다.
# PAYMENT_WEBHOOK_SECRET=

# 수수료율(%, 0~100 정수). 수수료는 Math.floor(상한 × 수수료율 / 100)이다. 비우면 10이다.
# FEE_RATE_STORE_OFFER=10
# FEE_RATE_BID=10
# FEE_RATE_BRAND_CONTRACT=10

# 수동 시험용: 시각을 이 일수만큼 앞당긴다(정수, 기본 0). 서버를 다시 켜면 때가 된 작업이 바로 돈다.
# NODE_ENV=development에서만 효과가 있고, 운영에서 0이 아니면 서버가 시작을 거부한다.
# FAKE_CLOCK_OFFSET_DAYS=0

# Supabase 프로젝트 URL.
# 대시보드 Project Settings → Data API 의 "Project URL".
SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase service_role 키.
# 대시보드 Project Settings → API Keys 의 service_role (secret) 키.
# 모든 RLS를 우회하는 키이므로 서버에서만 쓴다. 앱, 로그, 커밋에 절대 넣지 않는다.
# 개발 계정 시드와 Storage(사진 업로드 주소, yarn setup:supabase)가 쓴다. 운영에서 비면 서버가 시작을 거부한다.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# 호스트의 aws-0/aws-1 접두사는 프로젝트마다 다르므로 추측하지 말고
# 대시보드 Connect → ORMs 창에서 호스트를 그대로 복사한다.
# 풀링 연결(Supavisor 트랜잭션 모드, 포트 6543). 서버가 런타임에 쓴다.
# 대시보드 상단 Connect → Connection String → Transaction pooler 에서 복사한다.
# Prisma 6은 트랜잭션 풀러에서 ?pgbouncer=true 가 필요하다.
# schema=public 을 명시한다. 값이 없으면 Prisma가 search_path를 설정하지 않아,
# 같은 풀러를 쓰는 테스트(cora_test)의 search_path가 이 연결로 넘어올 수 있다.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# 세션 풀러(포트 5432). 마이그레이션처럼 트랜잭션 풀러를 거치면 안 되는 작업에 쓴다.
# 직접 연결 호스트(db.<ref>.supabase.co)는 IPv6 전용이라 IPv4 환경에서 닿지 않으므로 쓰지 않는다.
# 대시보드 Connect → ORMs 창의 Session pooler 문자열을 그대로 복사한다.
# schema=public 을 명시한다. 값이 없으면 마이그레이션이 이전 연결의 search_path(cora_test)를 물려받아
# migrate dev 가 테이블을 엉뚱한 스키마에 만들 수 있다.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=public"

# 계약상 남겨 두는 키다. 테스트는 이 값을 쓰지 않는다.
# 트랜잭션 풀러는 Prisma가 보낸 SET search_path를 다른 연결로 새게 해서, 테스트가 개발 DB의 public을 건드릴 수 있다.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=cora_test"

# 자동 테스트용. 같은 DB의 cora_test 스키마에서 돈다. 테스트는 이 세션 풀러 값만 쓴다.
# DIRECT_URL 에 ?schema=cora_test 를 붙인다.
TEST_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=cora_test"

# (선택) Supabase JWT 시크릿. 이 프로젝트의 Supabase는 비대칭 키(ES256)로 토큰을 서명하고
# JWKS로 검증하므로 필요하지 않다. 레거시 HS256 프로젝트일 때만 채운다.
# SUPABASE_JWT_SECRET=
